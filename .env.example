# Database
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# Spotify OAuth
# Create an app at https://developer.spotify.com/dashboard
# Includes playlist read/write scopes for Brain assistant actions.
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/auth/callback"

# Session secret - generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-strong-random-base64-secret"

# App
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# Sync behavior
# Number of 50-track pages to backfill per sync run
SPOTIFY_SYNC_MAX_PAGES="20"

# Client auto-sync polling while dashboard is open (milliseconds)
NEXT_PUBLIC_AUTO_SYNC_INTERVAL_MS="300000"

# Cron/background sync
CRON_SECRET="replace-with-a-strong-random-secret"
SPOTIFY_CRON_BATCH_SIZE="25"

# AI Brain chat (server-side only)
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
AI_CHAT_MAX_STEPS="4"
AI_CHAT_TIMEOUT_MS="20000"
AI_CHAT_RATE_LIMIT_PER_MIN="20"
